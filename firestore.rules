rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ---------- Helpers ---------- */
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Safety team members carry a custom claim: role = 'safety' or 'admin' (set by grantSafetyRole)
    // Wiji team: a document at safetyTeam/{uid} with role "admin" or "safety".
    // Add people by hand in the Firebase console, or from the admin website's Team page.
    function isStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/safetyTeam/$(request.auth.uid))
        && get(/databases/$(database)/documents/safetyTeam/$(request.auth.uid)).data.role in ['safety', 'admin'];
    }

    // convenience: have only these keys changed?
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(keys);
    }

    // Membership via users/{uid}.joinedCommunities (array of community IDs)
    function isMemberByUserDoc(communityId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.joinedCommunities is list)
        && (communityId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.joinedCommunities);
    }

    // Membership via group chat's members array (so users in the group can send/receive even if joinedCommunities missing)
    function isMemberOfGroupChat(communityId, chatId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/communities/$(communityId)/groupChats/$(chatId))
        && get(/databases/$(database)/documents/communities/$(communityId)/groupChats/$(chatId)).data.members is list
        && request.auth.uid in get(/databases/$(database)/documents/communities/$(communityId)/groupChats/$(chatId)).data.members;
    }

    function isBusinessOwner(businessId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/businesses/$(businessId))
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
    }

    function canCreateCommunityGroups(communityId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/communities/$(communityId))
        && (
          get(/databases/$(database)/documents/communities/$(communityId)).data.createdBy == request.auth.uid
          || (
            isMemberByUserDoc(communityId)
            && get(/databases/$(database)/documents/communities/$(communityId)).data.get('allowMembersToCreateGroups', false) == true
          )
        );
    }

    // Check if user is a chat participant (supports both array and map formats)
    // For get/update operations
    function isChatParticipant(chatId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && (
          (
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants is list
            && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          ) ||
          (
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants is map
            && get(/databases/$(database)/documents/chats/$(chatId)).data.participants[request.auth.uid] == true
          )
        );
    }

    function validCallStatus(s) {
      return s is string && s in ['ringing', 'accepted', 'declined', 'ended', 'missed', 'failed'];
    }

    function validCallTransition(oldStatus, newStatus) {
      return
        // Staying in the same state is needed too: the offer, answer and network details
        // (ICE candidates) are written while the call is ringing or connected.
        (oldStatus == 'ringing' && newStatus in ['ringing', 'accepted', 'declined', 'ended', 'missed', 'failed']) ||
        (oldStatus == 'accepted' && newStatus in ['accepted', 'ended', 'failed']) ||
        (oldStatus == 'declined' && newStatus == 'declined') ||
        (oldStatus == 'missed' && newStatus == 'missed') ||
        (oldStatus == 'failed' && newStatus == 'failed') ||
        (oldStatus == 'ended' && newStatus == 'ended');
    }

    /* ---------- Users ---------- */
    match /users/{userId} {
      // allow collection reads & doc reads for everyone
      allow read: if true;

      // Owner can create/update their own profile
      allow create: if isSignedIn() && request.auth.uid == userId;

      // Update rules:
      // 1. Owner can update their own profile
      // 2. Other users can add themselves to the friends map (for friend request acceptance)
      // Using map structure: friends: { [userId]: true }
      allow update: if isSignedIn() && (
        // Owner updating their own document
        request.auth.uid == userId ||
        // Other user adding themselves to friends map (friend request acceptance)
        (
          // Use changedKeys (top-level) so nested friend map entries don't fail this check.
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['friends']) &&
          request.resource.data.friends is map &&
          request.resource.data.friends[request.auth.uid] == true &&
          (resource.data.friends == null ||
           !(resource.data.friends is map) ||
           request.resource.data.friends.keys().hasAll(resource.data.friends.keys()))
        ) ||
        // Any user can add one chatId to another user's chatIds
        (
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['chatIds']) &&
          request.resource.data.chatIds is list &&
          (resource.data.get('chatIds', []) is list || !('chatIds' in resource.data)) &&
          request.resource.data.chatIds.hasAll(resource.data.get('chatIds', [])) &&
          request.resource.data.chatIds.size() == resource.data.get('chatIds', []).size() + 1
        )
      );
      allow delete: if false;
    }

    /* ---------- Chats (one-to-one) ---------- */
    match /chats/{chatId} {
      allow get, update: if isChatParticipant(chatId);

      allow list: if isSignedIn() && (
        (resource.data.participants is list && request.auth.uid in resource.data.participants) ||
        (resource.data.participants is map && resource.data.participants[request.auth.uid] == true)
      );

      allow create: if isSignedIn() && (
        (request.resource.data.participants is list && request.auth.uid in request.resource.data.participants) ||
        (request.resource.data.participants is map && request.resource.data.participants[request.auth.uid] == true)
      );

      allow delete: if false;

      match /messages/{messageId} {
        allow get: if isChatParticipant(chatId);
        allow list: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && (
            request.resource.data.senderId == request.auth.uid
            || request.resource.data.senderUid == request.auth.uid
          );
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    /* ---------- Businesses ---------- */
    // Public shop profile of a VERIFIED business (created by Cloud Functions when Wiji verifies it).
    // The owner can only change their own shop settings; name, location and verification are fixed.
    match /businesses/{businessId} {
      allow get, list: if true;
      allow create, delete: if false;
      allow update: if isBusinessOwner(businessId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isOpen', 'collectEnabled', 'deliveryEnabled', 'deliveryFeeCents', 'description', 'hours', 'updatedAt'])
        && (!('deliveryFeeCents' in request.resource.data) || (request.resource.data.deliveryFeeCents is int
             && request.resource.data.deliveryFeeCents >= 0 && request.resource.data.deliveryFeeCents <= 50000));

      match /catalog/{itemId} {
        allow get, list: if true;
        allow create, update, delete: if isBusinessOwner(businessId);
      }

      // Menu items customers can buy. Prices are in cents; the server re-reads them at checkout.
      match /menu/{itemId} {
        allow get, list: if true;
        allow delete: if isBusinessOwner(businessId);
        allow create, update: if isBusinessOwner(businessId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
          && request.resource.data.priceCents is int
          && request.resource.data.priceCents >= 100 && request.resource.data.priceCents <= 2000000
          && request.resource.data.available is bool;
      }
    }

    /* ---------- Orders ---------- */
    // Orders are created, priced and moved along only by Cloud Functions (functions/src/shop.ts)
    match /orders/{orderId} {
      allow get, list: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    /* ---------- Communities ---------- */
    match /communities/{communityId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;

      match /groupChats/{chatId} {
        allow get, list: if isSignedIn();

        allow create: if canCreateCommunityGroups(communityId)
        && request.resource.data.keys().hasAny(['name', 'title']);

        allow update: if (
          (
            isMemberByUserDoc(communityId)
            && changedOnly(['members'])
            && (request.resource.data.members is list)
            && !(request.auth.uid in (resource.data.members is list ? resource.data.members : []))
            && (request.auth.uid in request.resource.data.members)
            && request.resource.data.members.size()
              == ((resource.data.members is list ? resource.data.members.size() : 0) + 1)
          )
          ||
          (
            isMemberOfGroupChat(communityId, chatId)
            && request.resource.data.diff(resource.data).changedKeys().hasOnly(['lastMessageText', 'lastMessageSenderId', 'lastMessageTimestamp', 'unreadCount', 'pinnedMessage'])
          )
          ||
          (
            exists(/databases/$(database)/documents/communities/$(communityId))
            && get(/databases/$(database)/documents/communities/$(communityId)).data.createdBy == request.auth.uid
          )
          ||
          (resource.data.createdBy == request.auth.uid)
          ||
          (
            isMemberOfGroupChat(communityId, chatId)
            && changedOnly(['members'])
            && (request.resource.data.members is list)
            && (request.auth.uid in resource.data.members)
            && !(request.auth.uid in request.resource.data.members)
            && request.resource.data.members.size() == resource.data.members.size() - 1
          )
        );

        allow delete: if (
          (isMemberByUserDoc(communityId) && resource.data.createdBy == request.auth.uid)
          ||
          (
            exists(/databases/$(database)/documents/communities/$(communityId))
            && get(/databases/$(database)/documents/communities/$(communityId)).data.createdBy == request.auth.uid
          )
        );

        match /messages/{messageId} {
          allow get, list: if isSignedIn()
            && (isMemberByUserDoc(communityId) || isMemberOfGroupChat(communityId, chatId)
                || (exists(/databases/$(database)/documents/communities/$(communityId))
                    && get(/databases/$(database)/documents/communities/$(communityId)).data.createdBy == request.auth.uid));

          allow create: if (
            (
              (isMemberByUserDoc(communityId) || isMemberOfGroupChat(communityId, chatId))
              && (
                (request.resource.data.senderId == request.auth.uid) ||
                (request.resource.data.senderUid == request.auth.uid)
              )
            )
            ||
            (
              exists(/databases/$(database)/documents/communities/$(communityId))
              && get(/databases/$(database)/documents/communities/$(communityId)).data.createdBy == request.auth.uid
            )
          );

          allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
          allow update: if isSignedIn() && resource.data.senderId == request.auth.uid;
        }

        match /subscriptionPayments/{memberId} {
          allow read: if isSignedIn()
            && (
              get(/databases/$(database)/documents/communities/$(communityId)/groupChats/$(chatId)).data.createdBy == request.auth.uid
              || (memberId == request.auth.uid && isMemberOfGroupChat(communityId, chatId))
            );
          allow write: if isSignedIn()
            && (
              get(/databases/$(database)/documents/communities/$(communityId)/groupChats/$(chatId)).data.createdBy == request.auth.uid
              || memberId == request.auth.uid
            );
        }
      }

      match /chats/{chatId} {
        allow get, list: if isSignedIn();

        allow create: if canCreateCommunityGroups(communityId)
          && request.resource.data.keys().hasAny(['name', 'title']);

        allow update: if isMemberByUserDoc(communityId)
          && changedOnly(['members'])
          && (request.resource.data.members is list)
          && !(request.auth.uid in (resource.data.members is list ? resource.data.members : []))
          && (request.auth.uid in request.resource.data.members)
          && request.resource.data.members.size()
             == ((resource.data.members is list ? resource.data.members.size() : 0) + 1);

        allow delete: if isMemberByUserDoc(communityId)
          && resource.data.createdBy == request.auth.uid;

        match /messages/{messageId} {
          allow get, list: if isSignedIn();
          allow create: if isMemberByUserDoc(communityId)
            && (
              (request.resource.data.senderId == request.auth.uid) ||
              (request.resource.data.senderUid == request.auth.uid)
            );
          allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
          allow update: if isSignedIn() && resource.data.senderId == request.auth.uid;
        }
      }
    }

    /* ---------- Driver applications/profile ---------- */
    // Driver applications hold ID numbers and documents: only the applicant and the safety team see them.
    // Applicants can edit only while their application is a draft; status, checks and decisions
    // are changed only by Cloud Functions (submitDriverApplication / reviewDriverApplication).
    match /driver_applications/{uid} {
      allow read: if isSelf(uid) || isStaff();
      allow create: if isSelf(uid)
        && request.resource.data.status == 'draft'
        && !request.resource.data.keys().hasAny(['checks', 'decision', 'submittedAt', 'approvedAt', 'reverify', 'lastApproved']);
      allow update: if isSelf(uid)
        && resource.data.status == 'draft'
        && request.resource.data.status == 'draft'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['checks', 'decision', 'submittedAt', 'approvedAt', 'status', 'reverify', 'lastApproved', 'reopenedAt', 'changedDocs']);
      allow delete: if false;
    }

    // Public, verified driver profile shown to passengers. Written only by Cloud Functions on approval.
    match /drivers/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Live position of online drivers: only active, verified drivers can publish their own position,
    // and only signed-in users can read it.
    match /drivers_live/{uid} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid)
        && exists(/databases/$(database)/documents/drivers/$(uid))
        && get(/databases/$(database)/documents/drivers/$(uid)).data.status == 'active';
    }

    // Trip ratings: the driver sees their own (the app hides who rated), the safety team sees all.
    // Written only by Cloud Functions (rateRide).
    match /driverRatings/{rideId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.driverUid == request.auth.uid);
      allow write: if false;
    }

    // Who reviewed what, and when: visible to the safety team only, never editable.
    match /driverReviewLog/{entryId} {
      allow read: if isStaff();
      allow write: if false;
    }

    /* ---------- Rides (Wiji Rides) ---------- */
    // A ride is visible to its passenger, its driver, and the driver it's currently offered to.
    // Every status change happens in Cloud Functions (functions/src/rides.ts), never from the app.
    match /rides/{rideId} {
      allow read: if isSignedIn() && (
        resource.data.riderUid == request.auth.uid ||
        resource.data.driverUid == request.auth.uid ||
        resource.data.offeredTo == request.auth.uid ||
        isStaff()
      );
      allow write: if false;
    }

    // The trip PIN: only the passenger can read it, so a driver can't start a trip without them
    match /ridePins/{rideId} {
      allow read: if isSignedIn() && resource.data.riderUid == request.auth.uid;
      allow write: if false;
    }

    // Emergency alerts and incident reports: the safety team, plus the person who raised them
    match /safetyAlerts/{alertId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.raisedBy == request.auth.uid);
      allow write: if false;
    }
    match /incidentReports/{reportId} {
      allow read: if isStaff() || (isSignedIn() && resource.data.reporterUid == request.auth.uid);
      allow write: if false;
    }
    match /safetyTeam/{uid} {
      allow read: if isSelf(uid) || isStaff();
      allow write: if false;
    }

    /* ---------- Activities (Real-Time Meetups) ---------- */
    match /activities/{activityId} {
      allow read: if request.auth != null;

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.get('participants', []) is list
        && request.auth.uid in request.resource.data.get('participants', []);

      allow update: if isSignedIn() && (
        resource.data.createdBy == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
          && request.resource.data.participants is list
          && request.resource.data.participants.hasAll(resource.data.participants)
          && request.auth.uid in request.resource.data.participants
        )
      );

      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /joinRequests/{requestId} {
        allow create: if isSignedIn();
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/activities/$(activityId)).data.createdBy == request.auth.uid
          || resource.data.userId == request.auth.uid
        );
        allow update: if false;
        allow delete: if isSignedIn() && (
          get(/databases/$(database)/documents/activities/$(activityId)).data.createdBy == request.auth.uid
          || resource.data.userId == request.auth.uid
        );
      }
    }

    /* ---------- Activity Chats ---------- */
    match /activityChats/{activityId} {
      allow read, write: if isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/activities/$(activityId)).data.get('participants', []);
      match /messages/{messageId} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/activities/$(activityId)).data.get('participants', []);
      }
    }

    /* ---------- Activity Memories ---------- */
    match /activityMemories/{memoryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['activityId', 'videoUrl', 'userId', 'userName', 'createdAt', 'expiresAt', 'latitude', 'longitude'])
        && request.auth.uid in get(/databases/$(database)/documents/activities/$(request.resource.data.activityId)).data.get('participants', []);
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    /* ---------- Future Trips ---------- */
    match /futureTrips/{tripId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['destination', 'startDate', 'endDate', 'userId', 'createdAt'])
        && request.resource.data.destination is string
        && request.resource.data.startDate is string
        && request.resource.data.endDate is string;

      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    /* ---------- Map specials / deals (radius notifications via Cloud Functions) ---------- */
    match /mapSpecials/{specialId} {
      allow read: if isSignedIn();

      // Only verified, active businesses can post deals, always under their own business
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.businessId == request.auth.uid
        && exists(/databases/$(database)/documents/businesses/$(request.auth.uid))
        && get(/databases/$(database)/documents/businesses/$(request.auth.uid)).data.active == true
        && (!('priceCents' in request.resource.data) || (request.resource.data.priceCents is int
             && request.resource.data.priceCents >= 100 && request.resource.data.priceCents <= 2000000))
        && request.resource.data.title is string
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.dealTimeUtc is string
        && request.resource.data.dealTimeUtc.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && (!('imageUrl' in request.resource.data) || request.resource.data.imageUrl is string)
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.weekdays is list
        && request.resource.data.weekdays.size() >= 1
        && request.resource.data.active == true;

      allow update: if isSignedIn()
        && resource.data.createdBy == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'businessId', 'lastNotifiedUtcDate', 'lastNotifiedOccurrenceKey']);

      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;
    }

    /* ---------- 1-to-1 Call Sessions ---------- */
    match /callSessions/{callId} {
      // One record: a participant (or nobody, if it doesn't exist yet, so a check never errors).
      allow get: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participants);
      // Queries must be where('participants', 'array-contains', myUid). Keep this a single
      // condition: Firestore checks queries against the rule itself, and an OR with type checks
      // can't be proven from the query, so the whole query was refused.
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.keys().hasAll(['participants', 'callerId', 'calleeId', 'status', 'createdAt', 'updatedAt'])
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId in request.resource.data.participants
        && request.resource.data.calleeId != request.resource.data.callerId
        && request.resource.data.status == 'ringing'
        && request.resource.data.offer == null
        && request.resource.data.answer == null;

      allow update: if isSignedIn()
        && resource.data.participants is list
        && request.auth.uid in resource.data.participants
        && request.resource.data.keys().hasAll(['participants', 'callerId', 'calleeId', 'status', 'updatedAt'])
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId
        && request.resource.data.calleeId != request.resource.data.callerId
        && validCallStatus(request.resource.data.status)
        && validCallTransition(resource.data.status, request.resource.data.status)
        && (
          !('offer' in request.resource.data)
          || request.resource.data.offer == null
          || request.resource.data.offer is map
        )
        && (
          !('answer' in request.resource.data)
          || request.resource.data.answer == null
          || request.resource.data.answer is map
        )
        && (
          !('offerCandidates' in request.resource.data)
          || request.resource.data.offerCandidates is list
        )
        && (
          !('answerCandidates' in request.resource.data)
          || request.resource.data.answerCandidates is list
        )
        && (
          !('endedAt' in request.resource.data)
          || request.resource.data.endedAt is timestamp
        );

      allow delete: if false;
    }

    // Trusted contacts and trip-sharing settings: private to the user (their profile doc is public)
    match /users/{userId}/safety/{docId} {
      allow read, write: if isSelf(userId);
    }

    /* ---------- Paystack payments (all writes happen in Cloud Functions) ---------- */
    // Drivers and merchants who can receive payments: anyone signed in can see who they're paying
    match /payees/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }
    // A payment is visible only to the person who paid and the person who was paid
    match /payments/{reference} {
      allow read: if isStaff() || (isSignedIn()
        && (resource.data.payerUid == request.auth.uid || resource.data.payeeUid == request.auth.uid));
      allow write: if false;
    }
    // Saved cards: owner sees brand and last 4 digits only; the Paystack token lives in
    // paystackAuthorizations, which the catch-all below keeps unreadable
    match /paymentMethods/{uid}/cards/{cardId} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    /* ---------- Business verification ---------- */
    // Owner ID numbers, addresses and documents: only the owner and the Wiji team see them.
    // The owner edits only while it's a draft; status and decisions change only in Cloud Functions
    // (submitBusinessVerification / reviewBusinessVerification).
    match /business_verifications/{uid} {
      allow read: if isSelf(uid) || isStaff();
      allow create: if isSelf(uid)
        && request.resource.data.status == 'draft'
        && !request.resource.data.keys().hasAny(['decision', 'submittedAt', 'verifiedAt', 'reviewer']);
      allow update: if isSelf(uid)
        && resource.data.status == 'draft'
        && request.resource.data.status == 'draft'
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['decision', 'submittedAt', 'verifiedAt', 'reviewer', 'status']);
      allow delete: if false;
    }
    match /businessReviewLog/{entryId} {
      allow read: if isStaff();
      allow write: if false;
    }
    // Admin website activity log
    match /adminLog/{entryId} {
      allow read: if isStaff();
      allow write: if false;
    }

    /* ---------- Catch-all ---------- */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
