# Paystack (payments to drivers and merchants)
# Use your TEST secret key while building: Paystack Dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
# Wiji's commission on each payment, in percent
PAYSTACK_PLATFORM_FEE_PERCENT=5
# Emails allowed to grant safety-team roles (comma-separated) — set to your own account
SAFETY_ADMIN_EMAILS=you@example.com
# Wiji Rides fares (in cents)
RIDES_BASE_FARE_CENTS=1500
RIDES_PER_KM_CENTS=800
RIDES_MIN_FARE_CENTS=3000
